# Copy to .env and fill in.
OPENAI_API_KEY=sk-your-openai-key

# Optional: which model the agents use (defaults to gpt-4o-mini in code).
# CREWPILOT_MODEL=gpt-4o-mini

# Optional: comma-separated list of allowed frontend origins for CORS.
# Defaults to http://localhost:5173 when unset.
CORS_ALLOW_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app
